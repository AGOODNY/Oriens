{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://oriens.local/schemas/advice-v1.schema.json",
  "title": "Oriens 可展示建议 v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "advice", "reason", "confidence", "sources", "state_seq", "cost",
    "collectible_id", "item_name", "simulated", "delivery_note"
  ],
  "properties": {
    "advice": {"type": "string", "minLength": 1, "maxLength": 160},
    "reason": {"type": "string", "minLength": 1, "maxLength": 240},
    "confidence": {"type": "number", "minimum": 0, "maximum": 1},
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "title", "url"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "title": {"type": "string", "minLength": 1},
          "url": {"type": "string", "pattern": "^https://"}
        }
      }
    },
    "state_seq": {"type": "integer", "minimum": 1},
    "cost": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "model", "input_tokens", "output_tokens", "estimated_cost_cny",
        "run_total_cny", "currency", "estimated"
      ],
      "properties": {
        "model": {"type": "string", "minLength": 1},
        "input_tokens": {"type": "integer", "minimum": 0},
        "output_tokens": {"type": "integer", "minimum": 0},
        "estimated_cost_cny": {"type": "number", "minimum": 0},
        "run_total_cny": {"type": "number", "minimum": 0},
        "currency": {"const": "CNY"},
        "estimated": {"const": true}
      }
    },
    "collectible_id": {"type": "integer", "minimum": 1},
    "item_name": {"type": "string", "minLength": 1},
    "simulated": {"type": "boolean"},
    "delivery_note": {"type": ["string", "null"]}
  }
}
